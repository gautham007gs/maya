{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 5000 -H 0.0.0.0",
    "dev:turbopack": "next dev --turbopack -p 5000 -H 0.0.0.0",
    "build": "next build",
    "build:prod": "next build",
    "build:analyze": "next build",
    "images:webp": "node scripts/generate-webp-images.mjs",
    "start": "next start -p ${PORT:-5000} -H 0.0.0.0",
    "start:prod": "next start -p ${PORT:-5000} -H 0.0.0.0",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/__tests__/*.test.ts src/lib/brain/__tests__/*.test.mjs",
    "test:geo": "node scripts/test-geo-localization.mjs",
    "seo:crawl": "node scripts/seo-crawl.mjs",
    "benchmark:conversation": "node --env-file=.env node_modules/.bin/tsx scripts/conversation-benchmark.mjs",
    "perf": "npm run build && npm run start"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@next/bundle-analyzer": "^16.3.3",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/typography": "^0.5.20",
    "@types/sanitize-html": "^2.16.1",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.37.0",
    "mysql2": "^3.24.2",
    "next": "^16.3.3",
    "openai": "6.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-onesignal": "^3.5.6",
    "recharts": "^3.10.1",
    "sanitize-html": "2.16.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "cssnano": "^7.1.9",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "Chrome >= 110",
    "Firefox >= 110",
    "Safari >= 16",
    "Edge >= 110"
  ]
