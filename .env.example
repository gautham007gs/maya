# ==============================================================================
# KRUTHIKA AI — ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# HOW TO USE:
#   1) Local dev:  cp .env.example .env.local   → fill in values.
#   2) Production (Hostinger): hPanel → your Node.js app → Environment
#      Variables → paste values there (use "Import .env" to paste in bulk).
#      NEVER commit a real .env file — only this template belongs in git.
#
# PRIORITY LEGEND (read this first):
#   🔴 REQUIRED     — missing/placeholder value = app throws and WON'T START,
#                      or every page 500s. This is not optional in production.
#   🟠 REQUIRED FOR FEATURE — the site boots fine, but this specific feature
#                      (chat, admin login) silently won't work without it.
#   🟡 RECOMMENDED  — app runs without it but in a degraded/less-secure mode.
#   🟢 OPTIONAL     — skip entirely if you don't use that integration.
#
# WHY THIS MATTERS: this codebase deliberately CRASHES on boot (or on every
# request) if a 🔴 REQUIRED secret is missing or still says "change_me_..." —
# that's a safety feature to stop you from accidentally running in production
# with insecure defaults. If you deploy and get "Internal Server Error" with
# no page loading at all, check hPanel → Runtime Logs first: it will name the
# exact missing variable.
# ==============================================================================


# ═══════════════════════════════════════════════════════════════════════════
# 🔴 TIER 1 — REQUIRED: app will not boot, or every page will 500, without these
# ═══════════════════════════════════════════════════════════════════════════

# ── App identity ──────────────────────────────────────────────────────────────
# Public origin of the site — no trailing slash.
#   Local dev:  http://localhost:5000
#   Production: https://kruthika.fun   (or https://www.kruthika.fun)
# SEO-CRITICAL: whatever host you write here becomes THE canonical host. In
# production the proxy 301-redirects every other hostname to it, and all
# canonical/sitemap/hreflang/OG URLs are built from it.
NEXT_PUBLIC_BASE_URL=http://localhost:5000

# ── Security secrets (all: random strings, 32+ chars) ────────────────────────
# Generate any of these yourself with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A ready-to-paste generated set was provided separately for this deployment —
# see the chat message / .env.production.generated file. Treat these as
# passwords: unique per environment, never reused, never committed.

# Signs/encrypts the visitor session cookie. THIS IS THE #1 CAUSE OF A
# SITE-WIDE "Internal Server Error" IF LEFT UNSET — Next.js middleware reads
# it on every single request.
COOKIE_SECRET=

# Signs internal API requests between server modules.
REQUEST_SIGNATURE_SECRET=

# Signs the admin panel's session cookie. Required for /admin login to work
# at all (throws when an admin login is attempted without it — doesn't
# affect the public site).
ADMIN_SESSION_SECRET=

# ── Admin panel login ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com

# Password — pick ONE method. In PRODUCTION you MUST use method B — method A
# (plaintext) makes the app THROW AND REFUSE TO START in production. It only
# exists for local development.
#
# A) Plain text — DEVELOPMENT ONLY. Also requires DEV_ONLY=true below, or the
#    app will crash on boot.
# ADMIN_PASSWORD=change_me_to_a_strong_password
#
# B) scrypt hash — REQUIRED METHOD for production. Generate a pair with:
#   node -e "const {scryptSync, randomBytes} = require('crypto'); const salt=randomBytes(16).toString('hex'); const hash=scryptSync(process.argv[1], salt, 64).toString('hex'); console.log('ADMIN_PASSWORD_SALT='+salt); console.log('ADMIN_PASSWORD_HASH='+hash);" "your-password"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=


# ═══════════════════════════════════════════════════════════════════════════
# 🟠 TIER 2 — REQUIRED FOR SPECIFIC FEATURES (site boots fine without these;
#             the named feature just won't work until you add them)
# ═══════════════════════════════════════════════════════════════════════════

# ── AI provider keys — needed for chat to actually respond ───────────────────
# Without AT LEAST ONE key below, the site loads fine but the chat feature has
# nothing to call. Preferred method: Admin Panel → AI Keys (encrypted in
# MySQL). Env vars below are fallbacks, merged automatically.
#
# Runtime cascade order (PROVIDER_ORDER in src/ai/multi-provider.ts):
#   openrouter → gemini → cloudflare → groq → cerebras → sambanova →
#   github → nvidia → mistral → cohere → deepseek
# All have a free tier except DeepSeek (very cheap).

OPENROUTER_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_TOKEN=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=

# Numbered pools (optional rotation) — leave blank unless you need more keys
# per provider than the single slot above. Accepts _1 through _20.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
CLOUDFLARE_API_TOKEN_1=
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_API_TOKEN_3=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
SAMBANOVA_API_KEY_1=
SAMBANOVA_API_KEY_2=
SAMBANOVA_API_KEY_3=
GITHUB_TOKEN_1=
GITHUB_TOKEN_2=
GITHUB_TOKEN_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
MISTRAL_API_KEY_1=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
COHERE_API_KEY_1=
COHERE_API_KEY_2=
COHERE_API_KEY_3=
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=


# ═══════════════════════════════════════════════════════════════════════════
# 🟡 TIER 3 — STRONGLY RECOMMENDED (site runs without these, but degraded or
#             less secure — set these for anything beyond a quick test)
# ═══════════════════════════════════════════════════════════════════════════

# ── MySQL database (Hostinger) ────────────────────────────────────────────────
# Where: hPanel → Databases → MySQL. NOT auto-provisioned by Hostinger's
# Node.js panel (that one-click wizard only supports Supabase/MongoDB) — create
# it manually and paste the details here, then run the SQL files in database/.
# Without this the app runs in DEGRADED MODE: chat still responds, but user
# memory, blog, and media do not persist between restarts.
MYSQL_HOST=your-hostinger-mysql-host.hstgr.io
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database
# Max pool connections — clamped by code to 6–20, default 10. Raise toward 20
# only if you see pool-wait warnings under load.
MYSQL_CONNECTION_LIMIT=10

# AES-256-GCM master key that encrypts provider API keys stored in MySQL via
# the Admin Panel. Without it, keys derive an encryption key from your other
# secrets automatically (still works) — but setting this explicitly is safer.
# Once set and keys are saved, DO NOT change it or stored keys become
# undecryptable.
MASTER_ENCRYPTION_KEY=

# Server-side base URL for push-notification deep links and cron callbacks.
# Usually identical to NEXT_PUBLIC_BASE_URL. Without it, push notifications
# have no clickable target URL.
NEXT_PUBLIC_SITE_URL=

# Bearer token required by all /api/cron/* endpoints. Without it, the cron
# endpoints simply reject every call (no crash) — but scheduled re-engagement
# pushes, SEO indexing pings, and daily cleanup silently never run.
CRON_SECRET=


# ═══════════════════════════════════════════════════════════════════════════
# 🟢 TIER 4 — OPTIONAL: skip entirely unless you're using that specific
#             integration. Nothing in this tier can break the site by being
#             left blank.
# ═══════════════════════════════════════════════════════════════════════════

# Server port for local dev only. npm scripts already pass
# `-p ${PORT:-5000}`, so you normally never need this — Hostinger's Node.js
# panel injects PORT automatically; do NOT set it manually there.
# PORT=5000

# DEVELOPMENT-ONLY escape hatch ('true') — lets the app boot locally WITHOUT
# COOKIE_SECRET / REQUEST_SIGNATURE_SECRET by falling back to insecure dev
# defaults. NEVER set to true in production — it would silently disable the
# exact protections described in Tier 1 above.
DEV_ONLY=true

# How the server derives the real client IP behind Hostinger's proxy.
#   (blank) -> auto-detect (x-forwarded-for first, socket fallback) — recommended
#   proxy   -> always trust x-forwarded-for   (Hostinger/LiteSpeed)
#   direct  -> always use socket address      (when NOT behind a proxy)
TRUSTED_PROXY=

# Set to "true" in development/staging to block all search-engine crawlers.
# MUST be false/unset in production!
BLOCK_INDEXING=false

# Admin permission level for the RBAC system. Default: super_admin. Other
# roles: see ROLE_PERMISSIONS in src/lib/admin-rbac.ts.
ADMIN_ROLE=super_admin

# ── Text-to-speech (voice notes) — leave blank to disable voice replies ──────
ELEVENLABS_API_KEY_1=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=
SARVAM_API_KEY_1=
SARVAM_API_KEY_2=
SARVAM_API_KEY_3=

# ── Push notifications (OneSignal) — leave blank to disable ──────────────────
# Where: onesignal.com → Settings → Keys & IDs. App ID is safe to expose
# (NEXT_PUBLIC_); the REST key is server-only.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_DEFAULT_ICON_URL=
ONESIGNAL_DEFAULT_IMAGE_URL=

# ── Analytics & ads — leave blank to disable ──────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Blank = no-op, no scripts.
NEXT_PUBLIC_GA_ID=
# Adsterra Publisher API key — powers live ad revenue stats in Admin →
# Analytics. Where: beta.publishers.adsterra.com → Account → API.
ADSTERRA_API_KEY=

# ── SEO site verifications — leave blank if not verifying with these ────────
# Content tokens ONLY (not full meta tags).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
PINTEREST_VERIFICATION=

# ── Content Security Policy extensions — only if you add new 3rd-party hosts ─
CSP_SCRIPT_HOSTS=
CSP_CONNECT_HOSTS=
CSP_IMAGE_HOSTS=
CSP_FONT_HOSTS=
# Opt-in CSP weakenings for ad networks. Both default OFF. NEVER enable in
# production unless a specific ad product is provably broken without them.
ALLOW_AD_INLINE=false
ALLOW_ADS_INSECURE=false

# Screenshot / screen-record protection overlay (client-side deterrent only).
NEXT_PUBLIC_ENABLE_SCREENSHOT_PROTECTION=false

# ── Analytics retention ───────────────────────────────────────────────────────
# Days to keep raw analytics rows before the daily cleanup job purges them.
# Aggregates are always kept. Default: 90.
ANALYTICS_RETENTION_DAYS=90

# ── Database backups (scripts/backup-db.mjs) ──────────────────────────────────
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
# {file} is replaced with the backup path, e.g.:
# BACKUP_OFFSITE_CMD="rclone copy {file} remote:kruthika-backups"
BACKUP_OFFSITE_CMD=

# ── Media storage (uploads) ───────────────────────────────────────────────────
# Production: point at a writable folder OUTSIDE the deployed app, e.g.
# /home/<hosting-account>/cms-media. Every upload is ALSO persisted in MySQL
# (media_blobs), so files survive redeploys even if this folder is wiped.
CMS_MEDIA_ROOT=
CMS_MEDIA_PUBLIC_PATH=/uploads

# ── Cache (Upstash Redis) — falls back to in-memory caching if blank ─────────
# Where: upstash.com → Console → Create Database → REST API credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Misc ───────────────────────────────────────────────────────────────────────
# Timezone for daily message-quota resets. Default: Asia/Kolkata (IST).
QUOTA_TIMEZONE=Asia/Kolkata
